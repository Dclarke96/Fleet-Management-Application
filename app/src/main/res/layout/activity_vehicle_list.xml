<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vehicleListLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- TITLE -->
    <TextView
        android:id="@+id/vehicle_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Vehicles"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"/>

    <!-- GUIDANCE TEXT (FUE IMPROVEMENT) -->
    <TextView
        android:id="@+id/tvVehicleGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap a vehicle to view details or long press to edit/delete"
        android:textSize="12sp"
        android:alpha="0.6"
        android:paddingBottom="8dp"/>

    <!-- SEARCH BOX -->
    <EditText
        android:id="@+id/editSearchVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search vehicles by make, model, or license"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text" />

    <!-- EMPTY STATE (FUE IMPROVEMENT) -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No vehicles found.\nTap 'Add Vehicle' to get started."
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp"
        android:alpha="0.7"/>

    <!-- LIST -->
    <ListView
        android:id="@+id/vehicle_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BUTTONS -->
    <Button
        android:id="@+id/btnGenerateReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate Report"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAddVehicle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Vehicle"
        android:layout_marginBottom="8dp"/>

</LinearLayout>