<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ========================= -->
    <!-- MAIN CONTENT (UNCHANGED)  -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvVehicleDetailGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create or manage vehicle information and maintenance records"
                    android:textSize="14sp"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/editTitle"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vehicle Entry Name" />

                <EditText
                    android:id="@+id/editMake"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Make"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/editModel"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Model"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/editYear"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Year"
                    android:inputType="number"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/editLocation"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Location / Garage"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/editStartDate"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Start Date (YYYY-MM-DD)"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/editEndDate"
                    style="@style/AppInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="End Date (YYYY-MM-DD)"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginTop="8dp"/>

                <Switch
                    android:id="@+id/switchAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable Alerts"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Maintenance Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maintenance Records"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvMaintenanceEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No maintenance records available."
                android:textSize="14sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone"
                android:alpha="0.7"/>

            <ListView
                android:id="@+id/maintenanceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnAddMaintenance"
                    style="@style/AppButton_Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Maintenance"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnManageMaintenance"
                    style="@style/AppButton_Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manage Maintenance"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnSave"
                style="@style/AppButton_Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Vehicle"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDelete"
                style="@style/AppButton_Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Vehicle"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnShare"
                style="@style/AppButton_Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Share Vehicle Info"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnBack"
                style="@style/AppButton_Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back"/>

        </LinearLayout>

    </ScrollView>

    <!-- ========================= -->
    <!-- LOADING OVERLAY (NEW)     -->
    <!-- ========================= -->

    <View
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="10dp"/>

    <TextView
        android:id="@+id/tvLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_gravity="center"/>

</FrameLayout>